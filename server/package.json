{
  "name": "my-nest-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:worker:dev": "nest start --entryFile main.worker --watch",
    "start:worker:prod": "node dist/src/main.worker",
    "build": "nest build",
    "check:ai-dialogue-image-assets": "ts-node -r tsconfig-paths/register src/features/aiDialogue/imageGeneration/checkAiDialogueImageAssets.ts",
    "generatePrismaFile": "ts-node -r tsconfig-paths/register src/db/prismaGenerator/generatePrismaSchemaFile.ts",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:generate-types": "prisma generate client",
    "test": "jest --config src/jest.json --runInBand",
    "test:user-profile": "ts-node --files -r tsconfig-paths/register test/userProfile.integration.ts",
    "test:ai-dialogue-dictation": "ts-node --files -r tsconfig-paths/register test/aiDialogueDictation.integration.ts",
    "test:ai-dialogue-scenario-groups": "ts-node --files -r tsconfig-paths/register test/aiDialogueScenarioGroups.integration.ts",
    "test:ai-dialogue-illustration-styles": "ts-node --files -r tsconfig-paths/register test/aiDialogueIllustrationStyles.integration.ts",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config e2e/jest-e2e.ts --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@google-cloud/text-to-speech": "^7.2.0",
    "@google/genai": "^3.1.0",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/cqrs": "^12.1.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.1",
    "bullmq": "^6.7.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "express-session": "^1.19.0",
    "express-useragent": "^2.2.3",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^5.9.3",
    "jsonrepair": "^3.15.0",
    "music-metadata": "^12.4.0",
    "nest-winston": "^2.0.0",
    "openai": "^7.55.0",
    "posthog-node": "^5.72.0",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.38.0",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "subtitle": "^4.2.2",
    "swagger-ui-express": "^5.0.1",
    "ts-morph": "^28.0.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7",
    "ws": "^8.22.2",
    "youtube-dl-exec": "^3.1.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "9.39.3",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "prettier": "^3.10.0",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "@swc/core": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "protobufjs": true,
    "youtube-dl-exec": true,
    "@parcel/watcher": true,
    "fsevents": true,
    "@google/genai": true,
    "@scarf/scarf": false
  }
}
