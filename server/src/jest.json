{
	"moduleFileExtensions": [
		"js",
		"json",
		"ts"
	],
	"rootDir": ".",
	"testEnvironment": "node",
	"testRegex": ".spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapper": {
		"^types/(.*)$": "<rootDir>/types/$1",
		"^infrastructure/(.*)$": "<rootDir>/infrastructure/$1"
	}
}
