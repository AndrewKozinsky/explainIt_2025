{
	"moduleFileExtensions": [
		"js",
		"json",
		"ts"
	],
	"rootDir": ".",
	"testEnvironment": "node",
	"testRegex": ".spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapper": {
		"^types/(.*)$": "<rootDir>/types/$1",
		"^utils/(.*)$": "<rootDir>/utils/$1",
		"^infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
		"^db/(.*)$": "<rootDir>/db/$1",
		"^features/(.*)$": "<rootDir>/features/$1",
		"^repo/(.*)$": "<rootDir>/repo/$1",
		"^prisma/(.*)$": "<rootDir>/../prisma/$1"
	}
}
